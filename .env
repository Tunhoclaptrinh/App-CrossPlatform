# =================================================================
# UNIVERSAL REACT NATIVE BASE APP - ENVIRONMENT CONFIGURATION
# =================================================================
# Sao chép tệp này thành .env hoặc nạp vào CI/CD build scripts
# =================================================================

# 🌐 API & Backend Server Endpoints
API_BASE_URL=https://api.example.com/v1
API_TIMEOUT_MS=15000

# ⚡ Real-Time WebSocket Endpoint
WEBSOCKET_URL=wss://echo.websocket.org

# 🔐 Symmetric Encryption Secret Key (Khóa bí mật chia sẻ với Backend Server)
# Phải khớp với SECRET_KEY cấu hình trên Node.js, Python, Java hoặc Go
CRYPTO_SHARED_SECRET=rn_base_default_key_2026_super_secret

# 🤖 AI Assistant & LLM Endpoint
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini

# 📱 App Environment & Flags
APP_ENV=development
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
